Algoritmo Suma_3_valores
	Definir valor1, valor2, valor3 Como Real
	
	Escribir 'Hola vamos hacer la suma de 3 numeros'
	Escribir 'por favor digite el valor1'
	leer valor1
	
	Escribir 'por favor digite el valor2'
	leer valor2
	
	Escribir 'por favor digite ahora el valor3'
	leer valor3
	
	Suma<-valor1+valor2+valor3
	Escribir 'la suma de los 3 valores es:' suma
	
FinAlgoritmo
