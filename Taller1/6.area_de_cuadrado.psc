Algoritmo area_de_cuadrado
	Definir L, ac Como Real
	
	Escribir 'vamos a calcular el area de un cuadrado'
	Escribir 'por favor ingresar la longitud del lado del cuadrado'
	leer L
	
	ac<-L * L
	
	Escribir 'La longitud del cuadrado es:' L
	Escribir 'El area del cuadrado es:' ac
	
FinAlgoritmo
