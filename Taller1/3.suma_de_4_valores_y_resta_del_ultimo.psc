Algoritmo suma_de_4_valores_y_resta_del_ultimo
	Definir valor1, valor2, valor3, valor4 Como Real
	Escribir 'vamos hacer la suma de 4 valores y restar el ultimo valor'
	Escribir 'por favor digite el valor1'
	leer valor1
	
	Escribir 'por favor escribe el valor2'
	leer valor2
	
	Escribir 'por favor escribe el valor3'
	leer valor3
	
	Escribir 'por favor escribe el valor4'
	leer valor4
	
	resultado<-valor1+valor2+valor3+valor4
	Escribir 'el valor de la suma es:' resultado
	
	resultado2<-valor1+valor2+valor3+valor4-valor4
	Escribir 'el valor de la suma junto con la resta  es:' resultado2
	
FinAlgoritmo
