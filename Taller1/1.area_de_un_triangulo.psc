Algoritmo area_de_un_triangulo
	Definir b, h Como Real
	Escribir 'vamos a sacar el area del triangulo'
	Escribir 'por favor digite la base del triangulo'
	Leer b
	Escribir ' por favor digite la altura del triangulo'
	leer h
	
	aT<-(b*h) / 2
	
	Escribir 'el area del triangulo es:', aT
	
FinAlgoritmo
